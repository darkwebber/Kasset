# ─── Python ──────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
*.whl

# ─── Virtual Environment ─────────────────
venv/
.venv/
env/

# ─── IDE / Editor ────────────────────────
.vscode/
.idea/
.windsurf/
*.swp
*.swo
*~

# ─── OS Files ────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ─── Environment / Secrets ───────────────
.env
.env.*

# ─── Logs ────────────────────────────────
*.log
logs/

# ─── Model Files (large) ─────────────────
mlx-community/
*.safetensors
*.bin
*.gguf

# ─── Root-level npm artifacts (prevent module resolution hijack) ──
node_modules/
package.json
package-lock.json

# ─── Frontend Build ──────────────────────
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# ─── User-Generated Data ─────────────────
# All user data lives in ~/.qwen-studio/ (outside repo).
# These patterns catch anything accidentally created in-repo:
*.sqlite
*.db
